# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
# API port. The client proxy reads this same file, so changing it here is enough.
# If 4000 is already in use on your machine, pick another (e.g. 4100).
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB. Leave blank to run the embedded mongodb-memory-server instance
# (development/demo convenience only — data lives in .mongo/ under the server).
MONGODB_URI=
MONGODB_DB=watchspaces

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=45m
REFRESH_TOKEN_TTL_DAYS=7

# Seed accounts (created by `npm run seed` unless they already exist)
ADMIN_EMAIL=admin@watchspaces.dev
ADMIN_PASSWORD=Admin123!
HOST_EMAIL=host@watchspaces.dev
HOST_PASSWORD=Host123!
VIEWER_EMAIL=viewer@watchspaces.dev
VIEWER_PASSWORD=Viewer123!

# AI Co-Pilot. Optional OpenAI-compatible provider (Z.ai GLM by default).
# With no key configured the engine uses its deterministic grounded synthesizer,
# which still answers strictly from retrieved timeline entries.
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4
ZAI_MODEL=
# Generic OpenAI fallback (takes precedence only if set)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=8000
# Retrieval window around the playhead and the grounding floor. Coverage is the
# share of content words the top entry must match before an answer is allowed.
AI_LOOKBACK_SECONDS=360
AI_LOOKAHEAD_SECONDS=30
AI_MIN_SCORE=1.15
AI_MIN_COVERAGE=0.5

# Playback / rooms
HOST_DISCONNECT_GRACE_MS=15000
MAX_PARTICIPANTS_CEILING=50
DRIFT_SOFT_MS=250
DRIFT_HARD_MS=1200
